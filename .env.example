# Budget Tracker — Environment Variables
#
# Copy this file to .env and fill in the values.
# cp .env.example .env

# PostgreSQL / Neon connection string (production / Vercel mode)
# DATABASE_URL is the CANONICAL name.
# When set, the app uses Postgres via @neondatabase/serverless.
# When unset, the app uses SQLite (better-sqlite3) for local development.
# On Vercel, set this in Project Settings → Environment Variables.
# NEVER commit a real connection string — this file holds names only.
DATABASE_URL=

# DEPRECATED alias — POSTGRES_URL is still honored as a fallback while the
# migration is in progress (DATABASE_URL ?? POSTGRES_URL). Remove once all
# environments use DATABASE_URL.
POSTGRES_URL=

# JWT secret for session tokens
# REQUIRED when DATABASE_URL is set (production / Vercel).
# Generate one with:  openssl rand -base64 32
# On Vercel, set this in Project Settings → Environment Variables.
JWT_SECRET=
